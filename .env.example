APP_ENV=development
ENV_FILE=.env
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://okk_mcp:change-me@postgres:5432/okk_mcp
REDIS_URL=redis://redis:6379/0
OKK_API_BASE_URL=http://host.docker.internal:8002/api/v1
# password — форма логина и пароля шлюза; okk — вход на странице OKK (нужен секрет клиента шлюза в OKK)
MCP_LOGIN_MODE=password
OKK_MCP_CLIENT_ID=okk-mcp-gateway
OKK_MCP_CLIENT_SECRET=
OKK_PUBLIC_API_URL=
MCP_OAUTH_SECRET=replace-with-at-least-32-random-characters
MCP_SESSION_ENCRYPTION_SECRET=replace-with-another-32-character-secret
MCP_ISSUER_URL=http://localhost:8020
MCP_RESOURCE_URL=http://localhost:8020/mcp
MCP_ACCESS_TOKEN_MINUTES=60
MCP_REFRESH_TOKEN_DAYS=30
MCP_LOGIN_ATTEMPTS_PER_MINUTE=8
MCP_OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,https://chatgpt.com/connector/oauth/a-t9rb0LP-X4,https://chatgpt.com/connector_platform_oauth_redirect
MCP_REGISTRATIONS_PER_HOUR=20
MCP_TRUSTED_CLIENT_NETWORKS=160.79.104.0/21
MCP_TRUSTED_NETWORK_REGISTRATIONS_PER_HOUR=600
MCP_CLIENT_METADATA_DOCUMENTS_ENABLED=false
MCP_REFRESH_RETRY_SECONDS=30
MCP_CLEANUP_INTERVAL_MINUTES=60
MCP_AUDIT_RETENTION_DAYS=30
ANALYTICS_PARALLEL_REQUESTS=12
ANALYTICS_MAX_CALLS=5000
ANALYTICS_MAX_EMPLOYEES=2000
MCP_TOOL_CALLS_PER_MINUTE=60
MCP_TOOL_TIME_BUDGET_SECONDS=50
ANALYTICS_TRACE_ENABLED=true
OPENAI_APPS_CHALLENGE_TOKEN=
FORWARDED_ALLOW_IPS=127.0.0.1
