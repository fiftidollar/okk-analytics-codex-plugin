{
  "version": 1,
  "about": "OKK Analytics MCP eval cases. Prompts and answers contain no real data: placeholders are resolved and expected values are computed at run time from OKK reads made with the same account (see evals/README.md).",
  "placeholders": {
    "month_nom": "Current month in Moscow time, nominative: «октябрь».",
    "month_prep": "Current month, prepositional: «октябре».",
    "month_year": "Year of the current month.",
    "prev_month_prep": "Previous month, prepositional.",
    "prev_month_year": "Year of the previous month.",
    "prev_month_start": "First day of the previous month, YYYY-MM-DD.",
    "prev_month_end": "Last day of the previous month, YYYY-MM-DD.",
    "range_from_day": "Day 1 of the fixed range: days 1-15 of the current month after the 15th, otherwise of the previous month.",
    "range_to_day": "Day 15 of the fixed range.",
    "range_month_gen": "Month of the fixed range, genitive: «октября».",
    "range_year": "Year of the fixed range.",
    "range_start": "First day of the fixed range, YYYY-MM-DD.",
    "range_end": "Last day of the fixed range, YYYY-MM-DD.",
    "week_start": "Monday of the current week, YYYY-MM-DD.",
    "week_end": "Sunday of the current week, YYYY-MM-DD.",
    "department": "Code of the main department (--department, default csm); must be visible in get_access_context.",
    "department_name": "Name of the main department from get_access_context.",
    "department_other": "Code of another visible department (--other-department, default the first other code).",
    "department_other_name": "Name of that department.",
    "department_unscored_name": "A visible department other than the main one with no evaluated calls this month; the case is skipped if there is none.",
    "invisible_department": "A department phrase that matches no visible department (--invisible-department, default «маркетплейсов»).",
    "employee_card_id": "Id of the first employee by name with successful calls this month in the main department.",
    "employee_card_name": "Full name of that employee.",
    "employee_a_id": "Id of the employee with the most successful calls this month (ties by name).",
    "employee_a_name": "Full name of that employee.",
    "employee_b_id": "Id of the employee with the fewest (non-zero) successful calls this month; differs from employee_a.",
    "employee_b_name": "Full name of that employee.",
    "employee_short_id": "Id of the employee with the most successful calls shorter than the department minimum this month.",
    "employee_short_name": "Full name of that employee.",
    "unknown_person": "A name that matches no visible employee (--unknown-person, default «Иванов Пётр»).",
    "phrase": "A word to search in transcripts (--phrase, default «перезвоню»).",
    "call_id": "Id of the newest call of the main department this month.",
    "phone": "The client number that occurs most often on the first journal page of the main department this month.",
    "scenario_id": "Id of the only scenario of the main department; the case is skipped if there are several."
  },
  "cases": [
    {
      "id": "connect",
      "held_out": false,
      "prompt": "Проверь подключение OKK.",
      "tools": {"mode": "any", "names": ["get_access_context"]},
      "answer": {"any": ["подключ"]}
    },
    {
      "id": "avg_prev_month",
      "held_out": false,
      "prompt": "Какой средний балл оценки у отдела «{department_name}» в {prev_month_prep} {prev_month_year} года?",
      "tools": {"mode": "any", "names": ["get_department_statistics", "get_call_statistics", "get_overview_statistics", "get_scenario_performance"]},
      "args_any": [{"period": "prev_month"}, {"start_date": "{prev_month_start}", "end_date": "{prev_month_end}"}],
      "truth": {
        "reads": {"dept_prev": {"tool": "get_department_statistics", "args": {"department": "{department}", "period": "prev_month"}}},
        "expect": [{"as": "number", "value": "dept_prev:data.summary.average_score", "decimals": 1}]
      }
    },
    {
      "id": "avg_month",
      "held_out": false,
      "prompt": "Какой средний балл у отдела «{department_name}» за текущий месяц?",
      "tools": {"mode": "any", "names": ["get_department_statistics", "get_call_statistics", "get_overview_statistics", "get_scenario_performance"]},
      "truth": {
        "reads": {"dept": {"tool": "get_department_statistics", "args": {"department": "{department}", "period": "month"}}},
        "expect": [{"as": "number", "value": "dept:data.summary.average_score", "decimals": 1}]
      }
    },
    {
      "id": "range_count_avg",
      "held_out": false,
      "prompt": "Сколько оценённых звонков было у отдела «{department_name}» с {range_from_day} по {range_to_day} {range_month_gen} {range_year} года и какой у них средний балл?",
      "tools": {"mode": "any", "names": ["get_call_statistics", "get_department_statistics", "get_scenario_performance"]},
      "args_any": [{"start_date": "{range_start}", "end_date": "{range_end}"}],
      "truth": {
        "reads": {"calls": {"tool": "get_call_statistics", "args": {"department": "{department}", "start_date": "{range_start}", "end_date": "{range_end}"}}},
        "expect": [
          {"as": "number", "value": "calls:data.summary.evaluated_calls"},
          {"as": "number", "value": "calls:data.summary.avg_score", "decimals": 1}
        ]
      }
    },
    {
      "id": "pass_rate",
      "held_out": true,
      "prompt": "Какая доля звонков отдела «{department_name}» в {month_prep} оценена не ниже нормы?",
      "tools": {"mode": "any", "names": ["get_department_statistics", "get_call_statistics", "get_scenario_performance"]},
      "truth": {
        "reads": {"dept": {"tool": "get_department_statistics", "args": {"department": "{department}", "period": "month"}}},
        "expect": [{"as": "number", "value": "dept:data.summary.passing_rate", "decimals": 1}]
      }
    },
    {
      "id": "unscored_department_avg",
      "held_out": false,
      "prompt": "Какой средний балл у отдела «{department_unscored_name}» за {month_nom}?",
      "tools": {"mode": "any", "names": ["get_department_statistics", "get_call_statistics", "get_overview_statistics", "compare_departments"]},
      "answer": {
        "any": ["нет оцен", "не было", "нет звонк", "нет данных", "отсутств", "не оцен", "нет ни одного", "ноль звонков", "0 звонков", "звонков не", "0 оценён", "не рассчит", "не посчит"],
        "none": ["средний балл — 0", "средний балл 0", "балл: 0", "составляет 0", "составил 0", "0,0 балл"]
      }
    },
    {
      "id": "other_department_calls",
      "held_out": false,
      "prompt": "Сколько звонков было у отдела «{department_other_name}» в этом месяце?",
      "tools": {"mode": "any", "names": ["get_department_statistics", "get_call_statistics", "get_overview_statistics", "compare_departments", "get_client_statistics"]},
      "truth": {
        "reads": {"other": {"tool": "get_department_statistics", "args": {"department": "{department_other}", "period": "month"}}},
        "expect": [{"as": "number", "any_of": ["other:data.summary.calls_total", "other:data.summary.total_calls"]}]
      }
    },
    {
      "id": "invisible_department",
      "held_out": false,
      "prompt": "Покажи статистику отдела {invisible_department} за {month_nom}.",
      "tools": {"mode": "free", "names": []},
      "answer": {
        "any": ["нет доступ", "недоступ", "не найден", "нет такого", "нет отдела", "не нашел", "отсутству", "не вижу", "нет в списке", "только", "нет маркетплейс", "» нет", "в доступном списке", "не входит"]
      }
    },
    {
      "id": "compare_departments",
      "held_out": false,
      "prompt": "Сравни отделы «{department_name}» и «{department_other_name}» по числу звонков за {month_nom}.",
      "tools": {"mode": "any", "names": ["compare_departments", "get_department_statistics", "get_call_statistics", "get_overview_statistics"]},
      "truth": {
        "reads": {
          "dept": {"tool": "get_department_statistics", "args": {"department": "{department}", "period": "month"}},
          "other": {"tool": "get_department_statistics", "args": {"department": "{department_other}", "period": "month"}}
        },
        "expect": [
          {"as": "number", "any_of": ["dept:data.summary.calls_total", "dept:data.summary.total_calls"]},
          {"as": "number", "any_of": ["other:data.summary.calls_total", "other:data.summary.total_calls"]}
        ]
      }
    },
    {
      "id": "top_employee",
      "held_out": false,
      "prompt": "Кто в отделе «{department_name}» сделал больше всего звонков в {month_prep}?",
      "tools": {"mode": "any", "names": ["get_department_statistics", "get_overview_statistics", "compare_employees"]},
      "truth": {
        "reads": {"dept": {"tool": "get_department_statistics", "args": {"department": "{department}", "period": "month"}}},
        "expect": [{"as": "names", "value": "dept:data.complete_employee_ranking.employees | argmax_all:metrics.calls_total | map:full_name"}]
      }
    },
    {
      "id": "employee_card",
      "held_out": true,
      "prompt": "Покажи карточку сотрудника {employee_card_name} за {month_nom}: сколько состоявшихся звонков у этого сотрудника?",
      "tools": {"mode": "any", "names": ["get_employee_card", "get_department_statistics", "compare_employees"]},
      "truth": {
        "reads": {"dept": {"tool": "get_department_statistics", "args": {"department": "{department}", "period": "month"}}},
        "expect": [{"as": "number", "value": "dept:data.complete_employee_ranking.employees[id={employee_card_id}][0].metrics.calls_total"}]
      }
    },
    {
      "id": "unknown_person",
      "held_out": false,
      "prompt": "Как работает менеджер {unknown_person} из отдела «{department_name}»?",
      "tools": {"mode": "any", "names": ["list_employees", "get_department_statistics"]},
      "answer": {
        "any": ["не найден", "нет такого", "нет сотрудника", "отсутств", "не нашел", "не нашла", "не нашлось", "нет в отделе", "нет в составе", "не числится", "не значится", "не обнаруж"],
        "none": ["{unknown_person} сделал"]
      }
    },
    {
      "id": "roster",
      "held_out": false,
      "prompt": "Перечисли сотрудников отдела «{department_name}».",
      "tools": {"mode": "any", "names": ["list_employees", "get_department_statistics"]},
      "truth": {
        "reads": {
          "roster": {"tool": "list_employees", "args": {"department": "{department}"}},
          "everyone": {"tool": "list_employees", "args": {}}
        },
        "expect": [{"as": "names_exact", "value": "roster:data.items | map:full_name", "universe": "everyone:data.items | map:full_name"}]
      }
    },
    {
      "id": "compare_employees",
      "held_out": false,
      "prompt": "Сравни сотрудников {employee_a_name} и {employee_b_name} из отдела «{department_name}» за {month_nom}: сколько состоявшихся звонков у каждого?",
      "tools": {"mode": "any", "names": ["compare_employees", "get_department_statistics", "get_employee_card"]},
      "truth": {
        "reads": {"dept": {"tool": "get_department_statistics", "args": {"department": "{department}", "period": "month"}}},
        "expect": [
          {"as": "number", "value": "dept:data.complete_employee_ranking.employees[id={employee_a_id}][0].metrics.calls_total"},
          {"as": "number", "value": "dept:data.complete_employee_ranking.employees[id={employee_b_id}][0].metrics.calls_total"}
        ]
      }
    },
    {
      "id": "phrase_search",
      "held_out": false,
      "prompt": "Найди звонки отдела «{department_name}» за {month_nom}, где звучало слово «{phrase}». Кто их вёл?",
      "tools": {"mode": "any", "names": ["search_call_transcripts"]},
      "truth": {
        "reads": {"search": {"tool": "search_call_transcripts", "args": {"query": "{phrase}", "department": "{department}", "period": "month"}}},
        "preconditions": [{"value": "search:data.items | len", "op": "ge", "to": 1, "reason": "no call of the month contains the phrase"}],
        "expect": [{"as": "names", "value": "search:data.items | map:call.employee.full_name | unique"}]
      }
    },
    {
      "id": "read_transcript",
      "held_out": false,
      "prompt": "Покажи текст звонка {call_id}. Какой сотрудник его вёл?",
      "tools": {"mode": "any", "names": ["get_call_transcript"]},
      "truth": {
        "reads": {"call": {"tool": "get_call_transcript", "args": {"call_id": "{call_id}"}}},
        "expect": [{"as": "names", "value": "call:data.call.employee.full_name"}]
      }
    },
    {
      "id": "last_call",
      "held_out": true,
      "prompt": "Когда был последний звонок сотрудника {employee_card_name} в этом месяце и о чём он был?",
      "tools": {"mode": "any", "names": ["list_call_transcripts", "get_call_transcript", "search_call_transcripts"]},
      "truth": {
        "reads": {"last": {"tool": "list_call_transcripts", "args": {"department": "{department}", "employee_id": "{employee_card_id}", "period": "month", "page_size": 1}}},
        "expect": [{"as": "date", "value": "last:data.items[0].call.started_at"}]
      }
    },
    {
      "id": "plan_week",
      "held_out": false,
      "prompt": "Какой план звонков у отдела «{department_name}» на эту неделю и как он выполняется?",
      "tools": {"mode": "any", "names": ["get_plan_fact_statistics", "get_department_statistics"]},
      "truth": {
        "reads": {"plan": {"tool": "get_plan_fact_statistics", "args": {"start_date": "{week_start}", "end_date": "{week_end}", "department": "{department}"}}},
        "preconditions": [{"value": "plan:data.departments[0].mode", "op": "eq", "to": null, "reason": "a plan is set this week; the case checks the «no plan» answer"}]
      },
      "answer": {
        "any": ["не задан", "нет плана", "не установ", "отсутств", "нет данных", "не настро", "плана нет", "не найден", "не заведен"],
        "none": ["0 из", "выполнен на 0", "0%"]
      }
    },
    {
      "id": "scenario_performance",
      "held_out": false,
      "prompt": "Как отработан сценарий оценки отдела «{department_name}» в {month_prep}: сколько оценок и какой средний балл?",
      "tools": {"mode": "any", "names": ["get_scenario_performance"]},
      "truth": {
        "reads": {"scenarios": {"tool": "get_scenario_performance", "args": {"department": "{department}", "period": "month"}}},
        "preconditions": [{"value": "scenarios:data | len", "op": "eq", "to": 1, "reason": "the department has several scenarios this month"}],
        "expect": [
          {"as": "number", "value": "scenarios:data[0].evaluations"},
          {"as": "number", "value": "scenarios:data[0].avg_score", "decimals": 1}
        ]
      }
    },
    {
      "id": "weakest_criterion",
      "held_out": true,
      "prompt": "Какой критерий оценки у отдела «{department_name}» в {month_prep} получился хуже всего?",
      "tools": {"mode": "any", "names": ["get_criterion_performance"]},
      "truth": {
        "reads": {"criteria": {"tool": "get_criterion_performance", "args": {"department": "{department}", "period": "month"}}},
        "preconditions": [{"value": "criteria:data.criteria | len", "op": "ge", "to": 1, "reason": "no criterion was scored this month"}],
        "expect": [{"as": "text", "value": "criteria:data.criteria[0].criterion.name"}]
      }
    },
    {
      "id": "stop_words",
      "held_out": false,
      "prompt": "Сколько раз в {month_prep} в отделе «{department_name}» сработали стоп-слова?",
      "tools": {"mode": "any", "names": ["get_criterion_performance", "list_call_transcripts"]},
      "truth": {
        "reads": {"criteria": {"tool": "get_criterion_performance", "args": {"department": "{department}", "period": "month"}}},
        "preconditions": [{"value": "criteria:data.critical_errors | where_contains:criterion.name:стоп | len", "op": "ge", "to": 1, "reason": "the department has no stop-word critical error"}],
        "expect": [{"as": "number", "value": "criteria:data.critical_errors | where_contains:criterion.name:стоп | sum:violations"}]
      }
    },
    {
      "id": "scenario_criteria",
      "held_out": false,
      "prompt": "Какие критерии входят в сценарий оценки отдела «{department_name}»?",
      "tools": {"mode": "any", "names": ["get_scenario_criteria"]},
      "truth": {
        "reads": {"scenario": {"tool": "get_scenario_criteria", "args": {"scenario_id": "{scenario_id}"}}},
        "expect": [{"as": "text", "value": "scenario:data.criteria[category.is_critical=false] | map:name"}]
      }
    },
    {
      "id": "new_clients",
      "held_out": false,
      "prompt": "Сколько звонков новым клиентам было у отдела «{department_name}» в {month_prep}?",
      "tools": {"mode": "any", "names": ["get_client_statistics", "get_department_statistics"]},
      "truth": {
        "reads": {"dept": {"tool": "get_department_statistics", "args": {"department": "{department}", "period": "month"}}},
        "expect": [{"as": "number", "any_of": ["dept:data.summary.new_client_calls_total", "dept:data.summary.successful_new_total"]}]
      }
    },
    {
      "id": "missed",
      "held_out": true,
      "prompt": "Сколько пропущенных звонков у отдела «{department_name}» в {month_prep}?",
      "tools": {"mode": "any", "names": ["get_department_statistics", "get_client_statistics"]},
      "truth": {
        "reads": {"dept": {"tool": "get_department_statistics", "args": {"department": "{department}", "period": "month"}}},
        "expect": [{"as": "number", "value": "dept:data.summary.calls_missed"}]
      }
    },
    {
      "id": "avg_duration",
      "held_out": false,
      "prompt": "Какая средняя длительность звонков отдела «{department_name}» в {month_prep}?",
      "tools": {"mode": "any", "names": ["get_department_statistics", "get_call_statistics"]},
      "truth": {
        "reads": {"dept": {"tool": "get_department_statistics", "args": {"department": "{department}", "period": "month"}}},
        "expect": [{"as": "duration", "value": "dept:data.summary.avg_duration"}]
      }
    },
    {
      "id": "crm_unavailable",
      "held_out": false,
      "prompt": "Сколько просроченных задач в CRM у отдела «{department_name}»?",
      "tools": {"mode": "any", "names": ["get_crm_statistics"]},
      "truth": {
        "reads": {"crm": {"tool": "get_crm_statistics", "args": {"department": "{department}"}}},
        "preconditions": [{"value": "crm:data.coverage.available", "op": "eq", "to": 0, "reason": "CRM data is available; the case checks the «unavailable, not zero» answer"}]
      },
      "answer": {
        "any": ["недоступ", "не синхрон", "нет данных", "не подключ", "не привяз", "нет доступных", "отсутств", "не получ"],
        "none": ["0 просроч", "просроченных задач нет", "просроченных задач — 0"]
      }
    },
    {
      "id": "phone_count",
      "held_out": false,
      "prompt": "Сколько всего звонков было с номером {phone}?",
      "tools": {"mode": "any", "names": ["list_call_phone_records"]},
      "truth": {
        "reads": {"phone": {"tool": "list_call_phone_records", "args": {"phone_number": "{phone}"}}},
        "expect": [{"as": "number", "value": "phone:data.matching_calls_total"}]
      }
    },
    {
      "id": "prev_month_successful",
      "held_out": false,
      "prompt": "Сколько состоявшихся звонков было у отдела «{department_name}» в прошлом месяце?",
      "tools": {"mode": "any", "names": ["get_department_statistics", "get_overview_statistics", "compare_departments"]},
      "args_any": [{"period": "prev_month"}, {"start_date": "{prev_month_start}", "end_date": "{prev_month_end}"}],
      "truth": {
        "reads": {"dept_prev": {"tool": "get_department_statistics", "args": {"department": "{department}", "period": "prev_month"}}},
        "expect": [{"as": "number", "value": "dept_prev:data.summary.calls_total"}]
      }
    },
    {
      "id": "compare_months",
      "held_out": true,
      "prompt": "Сравни средний балл отдела «{department_name}» в {prev_month_prep} {prev_month_year} и в {month_prep} {month_year} года.",
      "tools": {"mode": "any", "names": ["get_department_statistics", "get_call_statistics", "get_overview_statistics"]},
      "truth": {
        "reads": {
          "dept_prev": {"tool": "get_department_statistics", "args": {"department": "{department}", "period": "prev_month"}},
          "dept": {"tool": "get_department_statistics", "args": {"department": "{department}", "period": "month"}}
        },
        "expect": [
          {"as": "number", "value": "dept_prev:data.summary.average_score", "decimals": 1},
          {"as": "number", "value": "dept:data.summary.average_score", "decimals": 1}
        ]
      }
    },
    {
      "id": "lowest_employee",
      "held_out": false,
      "prompt": "У кого в отделе «{department_name}» самый низкий средний балл за {month_nom} и какой?",
      "tools": {"mode": "any", "names": ["get_department_statistics", "compare_employees", "get_overview_statistics"]},
      "truth": {
        "reads": {"dept": {"tool": "get_department_statistics", "args": {"department": "{department}", "period": "month"}}},
        "expect": [
          {"as": "names", "value": "dept:data.complete_employee_ranking.employees | argmin:metrics.quality_score | map:full_name"},
          {"as": "number", "value": "dept:data.complete_employee_ranking.employees | argmin:metrics.quality_score | first | get:metrics.quality_score", "decimals": 1}
        ]
      }
    },
    {
      "id": "short_calls",
      "held_out": true,
      "prompt": "Сколько состоявшихся звонков сотрудника {employee_short_name} в {month_prep} были короче минимальной длительности отдела?",
      "tools": {"mode": "any", "names": ["get_department_statistics", "get_employee_card", "list_call_transcripts"]},
      "truth": {
        "reads": {"dept": {"tool": "get_department_statistics", "args": {"department": "{department}", "period": "month"}}},
        "expect": [{"as": "number", "value": {"sub": [
          "dept:data.complete_employee_ranking.employees[id={employee_short_id}][0].metrics.calls_total",
